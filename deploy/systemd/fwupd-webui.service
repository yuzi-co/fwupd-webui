[Unit]
Description=fwupd Web UI
Documentation=https://github.com/yuzi-co/fwupd-webui
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/fwupd-webui/env
ExecStart=/opt/fwupd-webui/venv/bin/python -m fwupd_webui
Restart=on-failure
RestartSec=5

# Runs as root deliberately: enumerating firmware means NVMe admin commands,
# SCSI generic ioctls and sysfs reads, none of which are available unprivileged.
User=root

# Hardening that does not conflict with talking to hardware. Notably absent:
# PrivateDevices and ProtectKernelModules, both of which would hide the devices
# this service exists to read.
NoNewPrivileges=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

# fwupd's metadata cache. Not covered by ProtectSystem=strict because fwupdtool
# writes elsewhere under /var and /sys during enumeration.
ReadWritePaths=/var/lib/fwupd

[Install]
WantedBy=multi-user.target
